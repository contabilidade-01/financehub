# ============================================================
# Khesef - Variáveis de Ambiente para Portainer
# ============================================================
# Copie estas variáveis para a seção "Environment variables"
# da Stack no Portainer e preencha os valores adequados.
# ============================================================

# === PORTAS (opcional) ===
APP_PORT=5000
POSTGRES_PORT=5432

# === BANCO DE DADOS ===
# Se usar o PostgreSQL do container, mantenha assim:
DATABASE_URL=postgresql://financehub:SUA_SENHA_SEGURA@postgres:5432/financehub

# Credenciais do PostgreSQL interno
POSTGRES_DB=financehub
POSTGRES_USER=financehub
POSTGRES_PASSWORD=SUA_SENHA_SEGURA

# === APLICAÇÃO ===
SESSION_SECRET=GERE_UMA_CHAVE_SEGURA_AQUI
BASE_URL=https://seu-dominio.com.br
SETUP=false
DEFAULT_LOCALE=pt-br

# === ASAAS (Gateway de Pagamento) ===
ASAAS_ENVIRONMENT=production
ASAAS_API_KEY=sua_api_key_asaas
ASAAS_WEBHOOK_SECRET=seu_webhook_secret

# === WEBHOOK ===
WEBHOOK_ATIVACAO_URL=https://seu-dominio.com.br/webhook/ativacao

# === EMAIL ===
EMAIL_FROM=noreply@seu-dominio.com.br
