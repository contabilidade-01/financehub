# =============================================
# FinanceHub — Variáveis de Ambiente
# =============================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env no repositório.
# =============================================

# === APLICAÇÃO ===
NODE_ENV=development
TZ=America/Sao_Paulo
PORT=5000
SETUP=false
DEFAULT_LOCALE=pt-br

# === BANCO DE DADOS (obrigatório) ===
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# === URL BASE ===
BASE_URL=https://seu-dominio.com

# === WEBHOOK DE ATIVAÇÃO (N8N — DESATIVADO) ===
# Pipeline agora roda internamente via POST /api/webhook/uazapi
# WEBHOOK_ATIVACAO_URL=https://seu-dominio.com/webhook/ativacao

# === ASAAS (Gateway de Pagamento) ===
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=sua_api_key_asaas
ASAAS_WEBHOOK_SECRET=seu_webhook_secret

# === EMAIL (opcional) ===
EMAIL_FROM=noreply@seu-dominio.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# === SESSÃO ===
SESSION_SECRET=gere_uma_chave_segura_256_chars

# === REDIS (opcional - cache) ===
# REDIS_URL=redis://localhost:6379

# === IA — Pipeline WhatsApp (substitui N8N) ===
OPENAI_API_KEY=sk-proj-sua_chave_openai
GEMINI_API_KEY=AIzaSy_sua_chave_gemini
AI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash

# === UAZAPI (Gateway WhatsApp) ===
# Token usado para validar que o webhook veio do UazAPI (opcional; se vazio, aceita qualquer POST)
# UAZAPI_WEBHOOK_TOKEN=seu_token_uazapi
# Base URL e token para alertas proativos (o app envia mensagens ativas ao usuário)
UAZAPI_BASE_URL=https://nescon.uazapi.com
UAZAPI_TOKEN=seu_token_instancia_uazapi
