# =============================================
# Khesef — Variáveis de Ambiente
# =============================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env no repositório.
# =============================================

# === APLICAÇÃO ===
NODE_ENV=development
TZ=America/Sao_Paulo
PORT=5000
SETUP=false
DEFAULT_LOCALE=pt-br

# === BANCO DE DADOS (obrigatório) ===
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# === URL BASE ===
BASE_URL=https://app.controledinheiro.com.br
PUBLIC_APP_URL=https://app.controledinheiro.com.br
FRONTEND_URL=https://app.controledinheiro.com.br

# === WEBHOOK DE ATIVAÇÃO (N8N — DESATIVADO) ===
# Pipeline agora roda internamente via POST /api/webhook/uazapi
# WEBHOOK_ATIVACAO_URL=https://seu-dominio.com/webhook/ativacao

# === ASAAS (Gateway de Pagamento) ===
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=sua_api_key_asaas
ASAAS_WEBHOOK_SECRET=seu_webhook_secret

# === EMAIL (mesmas vars do nescon-clientes) ===
# Com SMTP_HOST + SMTP_USER + SMTP_PASS + SMTP_FROM preenchidos, o envio liga sozinho.
# EMAIL_ENABLED=true força liga; EMAIL_ENABLED=false desliga mesmo com SMTP.
SMTP_HOST=smtp.seuprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-usuario
SMTP_PASS=sua-senha-de-app
SMTP_FROM=Khesef <noreply@controledinheiro.com.br>
# Legado (ainda aceito): EMAIL_FROM / SMTP_PASSWORD
EMAIL_FROM=noreply@controledinheiro.com.br

# URL pública do front (obrigatória para link de reset de senha)
# PUBLIC_APP_URL já definido acima
# PASSWORD_RESET_EXPIRY_MINUTES=60

# === SESSÃO ===
SESSION_SECRET=gere_uma_chave_segura_256_chars

# === REDIS (opcional - cache) ===
# REDIS_URL=redis://localhost:6379

# === IA — Pipeline WhatsApp (substitui N8N) ===
OPENAI_API_KEY=sk-proj-sua_chave_openai
GEMINI_API_KEY=AIzaSy_sua_chave_gemini
AI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash

# === UAZAPI (Gateway WhatsApp) ===
# Base URL e token da instância. O webhook /api/webhook/uazapi SÓ aceita POSTs
# cujo "token" no body seja UAZAPI_TOKEN (ou um de UAZAPI_WEBHOOK_TOKENS).
# As respostas sempre saem para UAZAPI_BASE_URL (nunca para a URL do payload).
UAZAPI_BASE_URL=https://nescon.uazapi.com
UAZAPI_TOKEN=seu_token_instancia_uazapi
# Tokens de outras instâncias autorizadas a chamar o webhook (separados por vírgula)
# UAZAPI_WEBHOOK_TOKENS=
# Segredo extra (recomendado): configure a URL do webhook como
# https://SEU_APP/api/webhook/uazapi?secret=VALOR
# UAZAPI_WEBHOOK_SECRET=

# === Integrações das empresas (Cora etc.) ===
# Chave que cifra os certificados/chaves que cada empresa envia (AES-256-GCM).
# Obrigatória em produção para usar o Cora; gere com: openssl rand -base64 48
# Trocar a chave invalida as credenciais já salvas (as empresas reenviam).
INTEGRACOES_SECRET=gere_com_openssl_rand_base64_48
# O aviso de pagamento do Cora chega em PUBLIC_APP_URL/BASE_URL (precisa ser https).
# RATE_LIMIT_WEBHOOK_MAX=300   # requisições/min por IP nos webhooks de provedores

# === Homologação / versão ===
# SIMULADOR_WHATSAPP=true   # só no app de homologação (nunca em produção)
# APP_ENV=homologacao
# APP_GIT_COMMIT=           # preenchido no Docker via --build-arg GIT_COMMIT

# === DeepSeek — só Orquestrador admin (/admin/orquestrador) ===
# DEEPSEEK_API_KEY=sk-sua_chave_deepseek
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
